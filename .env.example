# ==============================================================================
# CollegeCloud (Scholara) - Environment Variables Configuration
# ==============================================================================

# Supabase API URL:
# For Supabase Cloud: https://<project-ref>.supabase.co
# For Local Supabase CLI: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon (Publishable) Key:
# Safe to expose to the browser; used by client-side Supabase client with RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key:
# KEEP SECRET - Server-side only, bypasses Row-Level Security (used by admin tasks)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
